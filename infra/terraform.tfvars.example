# AWS Configuration
aws_region   = "us-east-1"
project_name = "rag-quality-gate"
environment  = "dev"

# Database Configuration
db_name     = "ragdb"
db_username = "ragadmin"

# Aurora Serverless v2 Capacity (ACUs)
db_min_capacity = 0.5
db_max_capacity = 2

# Bedrock Model IDs
embedding_model_id = "amazon.titan-embed-text-v2:0"
llm_model_id       = "anthropic.claude-3-5-sonnet-20241022-v2:0"

# RAG Configuration
chunk_size    = 512
chunk_overlap = 50
top_k         = 5

# VPC Configuration
vpc_cidr = "10.0.0.0/16"
