# AWS Configuration
aws_region   = "us-east-1"
project_name = "rag-quality-gate"
environment  = "dev"

# Database Configuration
db_name     = "ragdb"
db_username = "ragadmin"

# Aurora Serverless v2 Capacity (ACUs)
db_min_capacity = 0.5
db_max_capacity = 2

# Bedrock Model IDs
# Note: Anthropic models require submitting the Anthropic use-case form in Bedrock console
embedding_model_id = "amazon.titan-embed-text-v2:0"
llm_model_id       = "us.anthropic.claude-sonnet-4-6"

# Aurora Configuration
aurora_engine_version = "15.15"

# S3 Buckets
# Set to false for production to prevent accidental data loss
force_destroy_buckets = true

# RAG Configuration
chunk_size    = 400
chunk_overlap = 50
top_k         = 10

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# VPC Endpoints (optional, reduces NAT Gateway data transfer costs)
# Adds ~$14/month for interface endpoints but eliminates NAT data charges
enable_vpc_endpoints = false
